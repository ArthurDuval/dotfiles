general {
	colors = true
	interval = 5
}

order += "battery all"
order += "tztime local"

battery all {
	format = "%status %percentage"
	status_chr = "CHR"
	status_bat = "BAT"
	low_threshold = 20
	integer_battery_capacity = true
	threshold_type = percentage
	color_bad = "#FF0000"
}

tztime local {
	format = "%I:%M %p - %d/%m/%y "
}
