general {
	colors = true
		interval = 5
}

order += "battery all"
order += "volume master"
order += "tztime local"

battery all {
	format = "%status %percentage"
		status_chr = "CHR"
		status_bat = "BAT"
		status_unk = "UNK"
		status_full = "FULL"
		status_idle = "IDLE"
		path = "/sys/class/power_supply/BAT%d/uevent"
		low_threshold = 20
		threshold_type = "percentage"
		color_bad = "#FF0000"
		integer_battery_capacity = true
}

volume master {
	format = "♪: %volume"
		format_muted = "♪: muted (%volume)"
		device = "default"
		mixer = "Master"
		mixer_idx = 0
}

tztime local {
	format = "%d/%m/%Y %I:%M %p"
}
